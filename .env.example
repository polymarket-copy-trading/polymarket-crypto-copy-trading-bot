# Phemex API credentials (https://phemex.com/user/api-management)
PHEMEX_API_KEY=
PHEMEX_API_SECRET=

# API endpoints (use testnet for safe testing)
PHEMEX_BASE_URL=https://api.phemex.com
# PHEMEX_BASE_URL=https://testnet-api.phemex.com

# Trading pair (USDT-M perpetual)
PHEMEX_SYMBOL=BTCUSDT

# Grid parameters (AI may adjust these dynamically)
GRID_MODE=arithmetic
GRID_LOWER_PRICE=60000
GRID_UPPER_PRICE=70000
GRID_LEVELS=10
GRID_ORDER_SIZE=0.001

# AI optimization
AI_ENABLED=true
AI_REOPTIMIZE_INTERVAL_MS=300000
AI_RSI_PERIOD=14
AI_EMA_FAST=12
AI_EMA_SLOW=26
AI_ATR_PERIOD=14
AI_MIN_CONFIDENCE=0.3

# Risk management
MAX_QUOTE_EXPOSURE=5000
STOP_LOSS_PRICE=
TAKE_PROFIT_PRICE=
POLL_INTERVAL_MS=5000

# Position mode (Merged = one-way, Long/Short = hedge)
POS_SIDE=Merged

# Safety
DRY_RUN=false
LOG_LEVEL=info
